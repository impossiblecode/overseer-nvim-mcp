{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommitScope": null,
  "packageRules": [
    {
      "description": "Bundled into dist/, so an update needs a release.",
      "matchPackageNames": ["@modelcontextprotocol/sdk", "zod", "@msgpack/msgpack"],
      "semanticCommitType": "deps"
    },
    {
      "description": "Types track the lowest Node in engines.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "22.x"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the pinned overseer.nvim ref everywhere it appears: the CI env pin and the two docs that quote it.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^README\\.md$/",
        "/^CONTRIBUTING\\.md$/"
      ],
      "matchStrings": [
        "OVERSEER_REF: (?<currentValue>v[\\d.]+)",
        "--branch (?<currentValue>v[\\d.]+) https://github\\.com/stevearc/overseer\\.nvim",
        "tested against `(?<currentValue>v[\\d.]+)`"
      ],
      "depNameTemplate": "stevearc/overseer.nvim",
      "datasourceTemplate": "github-tags"
    }
  ]
}
